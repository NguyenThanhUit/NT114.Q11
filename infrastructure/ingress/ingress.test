# https://kubernetes.io/docs/concepts/services-networking/ingress/
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ingress-svc
  namespace: ingress-nginx
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - app.nguyenth4nh.xyz
        - api.nguyenth4nh.xyz
        - id.nguyenth4nh.xyz
      secretName: nguyenth4nh-app-tls
  rules:
    - host: app.nguyenth4nh.xyz
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: webapp-clusterip
                namespace: frontend  
                port:
                  number: 3000
    - host: api.nguyenth4nh.xyz
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: gateway-clusterip
                namespace: backend
                port:
                  number: 80
    - host: id.nguyenth4nh.xyz
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: identity-clusterip
                namespace: backend
                port:
                  number: 80
